                \u001b[90m│\u001b[39m\r\n\u001b[90m│\u001b[39m  e                  \u001b[90m│\u001b[39m\r\n\u001b[90m│\u001b[39m  d                  \u001b[90m│\u001b[39m\r\n\u001b[90m│\u001b[39m  )                  \u001b[90m│\u001b[39m\r\n\u001b[90m│\u001b[39m  \u001b                   \u001b[90m│\u001b[39m\r\n\u001b[90m│\u001b[39m  [                  \u001b[90m│\u001b[39m\r\n\u001b[90m│\u001b[39m  2                  \u001b[90m│\u001b[39m\r\n\u001b[90m│\u001b[39m  2m                 \u001b[90m│\u001b[39m\r\n\u001b[90m│\u001b[39m                     \u001b[90m│\u001b[39m\r\n\u001b[90m│\u001b[39m                     \u001b[90m│\u001b[39m\r\n\u001b[90m│\u001b[39m                     \u001b[90m│\u001b[39m\r\n\u001b[90m│\u001b[39m  \u001b                   \u001b[90m│\u001b[39m\r\n\u001b[90m│\u001b[39m  [                  \u001b[90m│\u001b[39m\r\n\u001b[90m│\u001b[39m  2                  \u001b[90m│\u001b[39m\r\n\u001b[90m│\u001b[39m  m                  \u001b[90m│\u001b[39m\r\n\u001b[90m│\u001b[39m  →                  \u001b[90m│\u001b[39m\r\n\u001b[90m│\u001b[39m  \u001b                   \u001b[90m│\u001b[39m\r\n\u001b[90m│\u001b[39m  [                  \u001b[90m│\u001b[39m\r\n\u001b[90m│\u001b[39m  2                  \u001b[90m│\u001b[39m\r\n\u001b[90m│\u001b[39m  2m                 \u001b[90m│\u001b[39m\r\n\u001b[90m│\u001b[39m                     \u001b[90m│\u001b[39m\r\n\u001b[90m│\u001b[39m  ~                  \u001b[90m│\u001b[39m\r\n\u001b[90m│\u001b[39m  /                  \u001b[90m│\u001b[39m\r\n\u001b[90m│\u001b[39m  w                  \u001b[90m│\u001b[39m\r\n\u001b[90m│\u001b[39m  o                  \u001b[90m│\u001b[39m\r\n\u001b[90m│\u001b[39m  r                  \u001b[90m│\u001b[39m\r\n\u001b[90m│\u001b[39m  k                  \u001b[90m│\u001b[39m\r\n\u001b[90m│\u001b[39m  /                  \u001b[90m│\u001b[39m\r\n\u001b[90m│\u001b[39m  .                  \u001b[90m│\u001b[39m\r\n\u001b[90m│\u001b[39m  a                  \u001b[90m│\u001b[39m\r\n\u001b[90m│\u001b[39m  g                  \u001b[90m│\u001b[39m\r\n\u001b[90m│\u001b[39m  e                  \u001b[90m│\u001b[39m\r\n\u001b[90m│\u001b[39m  n                  \u001b[90m│\u001b[39m\r\n\u001b[90m│\u001b[39m  t                  \u001b[90m│\u001b[39m\r\n\u001b[90m│\u001b[39m  s                  \u001b[90m│\u001b[39m\r\n\u001b[90m│\u001b[39m  /                  \u001b[90m│\u001b[39m\r\n\u001b[90m│\u001b[39m  s                  \u001b[90m│\u001b[39m\r\n\u001b[90m│\u001b[39m  k                  \u001b[90m│\u001b[39m\r\n\u001b[90m│\u001b[39m  i                  \u001b[90m│\u001b[39m\r\n\u001b[90m│\u001b[39m  l                  \u001b[90m│\u001b[39m\r\n\u001b[90m│\u001b[39m  l                  \u001b[90m│\u001b[39m\r\n\u001b[90m│\u001b[39m  s                  \u001b[90m│\u001b[39m\r\n\u001b[90m│\u001b[39m  /                  \u001b[90m│\u001b[39m\r\n\u001b[90m│\u001b[39m  s                  \u001b[90m│\u001b[39m\r\n\u001b[90m│\u001b[39m  i                  \u001b[90m│\u001b[39m\r\n\u001b[90m│\u001b[39m  g                  \u001b[90m│\u001b[39m\r\n\u001b[90m│\u001b[39m  m                  \u001b[90m│\u001b[39m\r\n\u001b[90m│\u001b[39m  a                  \u001b[90m│\u001b[39m\r\n\u001b[90m│\u001b[39m                     \u001b[90m│\u001b[39m\r\n\u001b[90m├─────────────────────╯\u001b[39m\r\n"]
